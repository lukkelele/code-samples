{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: configure",
      "type": "shell",
      "command": "cmake",
      "args": ["-S", "${fileDirname}", "-B", "${workspaceFolder}/build", "--fresh"],
      "options": {
        "cwd": "${fileDirname}",
        "env": {
          "REPO_ROOT": "${workspaceFolder}",
          "PROJECT_ROOT": "${relativeFileDirname}",
          "EXPERIMENTAL_DIR": "${workspaceFolder}/experimental",
          "EXPERIMENTAL_CPP_DIR": "${workspaceFolder}/experimental/cpp",
          "LIB_DIR": "${workspaceFolder}/lib",
          "LIB_CPP_DIR": "${workspaceFolder}/lib/cpp",
        },
      },
      "group": "build",
      "runOptions": {
        "reevaluateOnRerun": false,
      },
    },
    {
      "label": "cmake: build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build"],
      "options": {
        "cwd": "${fileDirname}",
        "env": {
          "REPO_ROOT": "${workspaceFolder}",
          "PROJECT_ROOT": "${relativeFileDirname}",
          "EXPERIMENTAL_DIR": "${workspaceFolder}/experimental",
          "EXPERIMENTAL_CPP_DIR": "${workspaceFolder}/experimental/cpp",
          "LIB_DIR": "${workspaceFolder}/lib",
          "LIB_CPP_DIR": "${workspaceFolder}/lib/cpp",
        },
      },
      "group": "build",
      "runOptions": {
        "reevaluateOnRerun": false,
      },
    },
    {
      "label": "cmake: clean",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--target", "clean"],
      "options": {
        "cwd": "${fileDirname}",
        "env": {
          "REPO_ROOT": "${workspaceFolder}",
          "PROJECT_ROOT": "${relativeFileDirname}",
          "EXPERIMENTAL_DIR": "${workspaceFolder}/experimental",
          "EXPERIMENTAL_CPP_DIR": "${workspaceFolder}/experimental/cpp",
          "LIB_DIR": "${workspaceFolder}/lib",
          "LIB_CPP_DIR": "${workspaceFolder}/lib/cpp",
        },
      },
      "runOptions": {
        "reevaluateOnRerun": false,
      },
      "problemMatcher": [],
    },
    {
      "label": "sample: run",
      "type": "shell",
      "command": "${workspaceFolder}/build/app/app",
      "dependsOn": "cmake: build",
      "runOptions": {
        "reevaluateOnRerun": false,
      },
      "problemMatcher": [],
    },
    {
      "label": "git: submodule: init",
      "type": "shell",
      "command": "git submodule update --init --recursive",
      "problemMatcher": [],
    },
  ],
}
