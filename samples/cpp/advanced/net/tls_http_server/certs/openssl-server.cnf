[req]
distinguished_name = dn
prompt = no
req_extensions = v3_req

[dn]
C = SE
ST = Test
L = Test
O = code-samples
OU = test-server
CN = localhost

[v3_req]
basicConstraints = CA:FALSE
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @alt

[alt]
DNS.1 = localhost
DNS.2 = host.docker.internal
IP.1 = 127.0.0.1
IP.2 = ::1
