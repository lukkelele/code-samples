[
    {
        "label": "cmake: configure",
        "command": "cmake",
        "args": [
          "-S ${ZED_DIRNAME}",
          "-B ${ZED_DIRNAME}/build",
          "--fresh",
          "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
        ],
        "cwd": "$ZED_WORKTREE_ROOT",
        "env": {
            "REPO_ROOT": "${ZED_WORKTREE_ROOT}",
            "PROJECT_ROOT": "${ZED_DIRNAME}",
            "EXPERIMENTAL_DIR": "${ZED_WORKTREE_ROOT}/experimental",
            "EXPERIMENTAL_CPP_DIR": "${ZED_WORKTREE_ROOT}/experimental/cpp",
            "LIB_DIR": "${ZED_WORKTREE_ROOT}/lib",
            "LIB_CPP_DIR": "${ZED_WORKTREE_ROOT}/lib/cpp"
        },
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true
    },
    {
        "label": "cmake: build",
        "command": "cmake",
        "args": ["--build ${ZED_DIRNAME}/build", "--parallel"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "env": {
            "REPO_ROOT": "${ZED_WORKTREE_ROOT}",
            "PROJECT_ROOT": "${ZED_DIRNAME}",
            "EXPERIMENTAL_DIR": "${ZED_WORKTREE_ROOT}/experimental",
            "EXPERIMENTAL_CPP_DIR": "${ZED_WORKTREE_ROOT}/experimental/cpp",
            "LIB_DIR": "${ZED_WORKTREE_ROOT}/lib",
            "LIB_CPP_DIR": "${ZED_WORKTREE_ROOT}/lib/cpp"
        },
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true
    },
    {
        "label": "cmake: clean",
        "command": "cmake",
        "args": ["--build ${ZED_DIRNAME}/build", "--target clean"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "env": {
            "REPO_ROOT": "${ZED_WORKTREE_ROOT}",
            "PROJECT_ROOT": "${ZED_DIRNAME}",
            "EXPERIMENTAL_DIR": "${ZED_WORKTREE_ROOT}/experimental",
            "EXPERIMENTAL_CPP_DIR": "${ZED_WORKTREE_ROOT}/experimental/cpp",
            "LIB_DIR": "${ZED_WORKTREE_ROOT}/lib",
            "LIB_CPP_DIR": "${ZED_WORKTREE_ROOT}/lib/cpp"
        },
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true
    },
    {
        "label": "build",
        "command": "./scripts/build.sh",
        "cwd": "$ZED_WORKTREE_ROOT",
        "env": {
            "REPO_ROOT": "${ZED_WORKTREE_ROOT}",
            "PROJECT_ROOT": "${ZED_DIRNAME}",
            "EXPERIMENTAL_DIR": "${ZED_WORKTREE_ROOT}/experimental",
            "EXPERIMENTAL_CPP_DIR": "${ZED_WORKTREE_ROOT}/experimental/cpp",
            "LIB_DIR": "${ZED_WORKTREE_ROOT}/lib",
            "LIB_CPP_DIR": "${ZED_WORKTREE_ROOT}/lib/cpp"
        },
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true
    },
    {
        "label": "run",
        "command": "./scripts/build.sh && ./scripts/run.sh",
        "cwd": "$ZED_WORKTREE_ROOT",
        "env": {
            "REPO_ROOT": "${ZED_WORKTREE_ROOT}",
            "PROJECT_ROOT": "${ZED_DIRNAME}",
            "EXPERIMENTAL_DIR": "${ZED_WORKTREE_ROOT}/experimental",
            "EXPERIMENTAL_CPP_DIR": "${ZED_WORKTREE_ROOT}/experimental/cpp",
            "LIB_DIR": "${ZED_WORKTREE_ROOT}/lib",
            "LIB_CPP_DIR": "${ZED_WORKTREE_ROOT}/lib/cpp"
        },
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true
    },
    {
        "label": "remove build dir",
        "command": "rm -rf ${ZED_DIRNAME}/build ${ZED_DIRNAME}/target",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true
    }
]
