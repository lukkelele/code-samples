{
    "name": "code-samples devcontainer",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "containerEnv": {
        "SHELL": "/bin/bash"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "xaver.clang-format",
                "twxs.cmake",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.vscode-python-envs",
                "ms-python.debugpy"
            ]
        }
    },
    "forwardPorts": [
        19020
    ],
    "runArgs": [
        "--privileged",
        "--add-host=host.docker.internal:host-gateway",
        "-v"
    ]
}