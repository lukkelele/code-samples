{
  "name": "code-samples [linux]",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "privileged": true,
  "remoteUser": "user",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "mounts": [
    "type=bind,source=/dev/bus/usb,target=/dev/bus/usb",
    "type=bind,source=/dev/input,target=/dev/input",
    "type=bind,source=/tmp/.X11-unix,target=/tmp/.X11-unix,readonly",
    "type=bind,source=${localEnv:XDG_RUNTIME_DIR}/wayland-0,target=/tmp/runtime-root/wayland-0"
  ],
  "containerEnv": {
    "SHELL": "/bin/bash",
    "DISPLAY": "${localEnv:DISPLAY}",
    "WAYLAND_DISPLAY": "wayland-0",
    "XDG_RUNTIME_DIR": "/tmp/runtime-root",
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "xaver.clang-format",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-python.debugpy",
        "rust-lang.rust-analyzer"
      ]
    }
  },
  "runArgs": [
    "--device=/dev/dri:/dev/dri",
    "--gpus", "all",
  ],
  "postStartCommand": "sudo /usr/local/bin/container-setup.sh",
  "forwardPorts": [8080]
}
